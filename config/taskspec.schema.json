{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskSpec",
  "description": "H ラインの実装役に渡す唯一の入力（docs/design/foundation_v3_review.md 改訂 5 §4）。分解役が What から作り、実装役を呼ぶ前に Gate A（harness/hline_spec.py）がこのスキーマで検査する。What の本文（自然言語の背景）は実装役に渡さない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_symbols", "signatures", "contracts", "edit_boundary", "test_oracle"],
  "properties": {
    "target_symbols": {
      "description": "1. 対象シンボル（モジュール・クラス・関数／メソッド）",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "kind", "name"],
        "properties": {
          "module": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["module", "class", "function", "method"] },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "signatures": {
      "description": "2. 型シグネチャ（引数と戻り値の型）",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "params", "returns"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 }
              }
            }
          },
          "returns": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contracts": {
      "description": "3. 事前条件・事後条件・不変量（論理の契約）",
      "type": "object",
      "additionalProperties": false,
      "required": ["preconditions", "postconditions", "invariants"],
      "properties": {
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "postconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "invariants": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "edit_boundary": {
      "description": "4. 編集境界。パスはリポジトリの根からの相対（/ 区切り）。* と ? が使える。末尾が / ならその下すべて。変えてはならないファイルが優先する",
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_files", "forbidden_files", "max_diff_lines"],
      "properties": {
        "allowed_files": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "forbidden_files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "deletable_files": { "description": "丸ごと消してよいファイル（省くと空。書き方は allowed_files と同じ）。ここに無いファイルを消すと Gate 1 が落とす", "type": "array", "items": { "type": "string", "minLength": 1 } },
        "max_diff_lines": { "type": "integer", "minimum": 1, "maximum": 300 }
      }
    },
    "test_oracle": {
      "description": "5. テストオラクルの指針（何をもって正しいとするか）。タスクを宣言した What では、verification_command に進捗の検証コマンドをそのまま入れる",
      "type": "object",
      "additionalProperties": false,
      "required": ["guidance"],
      "properties": {
        "guidance": { "type": "string", "minLength": 1 },
        "verification_command": { "type": "string", "minLength": 1 }
      }
    }
  }
}
